<?xml version="1.0" encoding="utf-8"?>
<!--
  The league table, top three only.

  Watching one match tells you who won it; the point of a standing is the run of matches
  behind it, and three lines is as much of that as can sit beside the ring without competing
  with the fight.

  No title row: the carousel tab above the panel names it in portrait, and in landscape three
  lines of rank, name and rating read as a table without a heading.

  The rows are cloned from Templates/StandingsRow.uxml rather than written out here, because
  how many places the panel shows is a serialized field on the view - hard-coding three rows
  in the layout would make that field a lie.

  Everything is picking-mode="Ignore". The panel sits over a live ring and must never eat a
  click meant for a panel sorted beneath it.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="panel" class="standings" picking-mode="Ignore">
        <ui:VisualElement name="rows" class="standings__rows" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
