<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the odds board: name, a bar of the probability, the figure, and which way it has
  moved over the last couple of seconds. The trend is a signed number rather than an arrow
  glyph, because the font atlases are baked over printable ASCII and an arrow would render as a
  missing-glyph box.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="row" class="odds__row" picking-mode="Ignore">
        <ui:Label name="name" class="text text--sm text--bold odds__name" picking-mode="Ignore" />
        <ui:VisualElement name="track" class="odds__track" picking-mode="Ignore">
            <ui:VisualElement name="fill" class="odds__fill" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="value" class="text text--sm text--bold odds__value" picking-mode="Ignore" />
        <ui:Label name="trend" class="text text--xs odds__trend" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
