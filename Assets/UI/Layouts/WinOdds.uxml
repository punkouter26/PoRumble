<?xml version="1.0" encoding="utf-8"?>
<!--
  The odds board: who is likely to be the last one standing, live.

  Three parts, read top to bottom. The head-to-head bar is the fight on camera, split by the two
  fighters' share of each other's chances - the same shape as a chess engine's evaluation bar.
  The rows are the field, best chance first, reshuffling as punches land. The last line is the
  viewer's own stake, which is the reason to care about the rows at all.

  This is one of two panels that stay up while the fight is live (the other is the second-fight
  feed). HudVisibilityView clears everything else so the ring can be watched; a win probability
  that disappeared exactly while it was moving would be pointless.

  Everything is picking-mode="Ignore". The board sits over a live ring.
-->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="panel" class="odds" picking-mode="Ignore">
        <ui:Label name="title" text="WIN PROBABILITY" class="text text--xs text--bold odds__title" picking-mode="Ignore" />

        <ui:VisualElement name="duel" class="odds__duel" picking-mode="Ignore">
            <ui:VisualElement name="duel-names" class="odds__duel-names" picking-mode="Ignore">
                <ui:Label name="duel-a" class="text text--xs text--bold odds__duel-name" picking-mode="Ignore" />
                <ui:Label name="duel-b" class="text text--xs text--bold odds__duel-name odds__duel-name--right" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="duel-track" class="odds__duel-track" picking-mode="Ignore">
                <ui:VisualElement name="duel-fill" class="odds__duel-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="rows" class="odds__rows" picking-mode="Ignore" />

        <ui:Label name="pick" class="text text--xs odds__pick" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
