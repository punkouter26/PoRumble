/*
 * PoRumble HUD design system.
 *
 * Both HUDs used to build every element with inline style assignments, each carrying its own
 * copy of the palette as `static readonly Color` fields. The two panels could drift apart with
 * nothing to catch it, and there was no shared spacing rhythm at all.
 *
 * Everything below the token block is expressed in terms of the tokens, so the whole HUD can
 * be recoloured or respaced from one place. C# still sets values that are genuinely dynamic -
 * a bar's width percentage - but never a colour or a padding.
 */

/* ----------------------------------------------------------------- design tokens */
:root {
    /* Surfaces. Deliberately translucent: the ring has to stay readable underneath. */
    --surface-panel: rgba(8, 9, 14, 0.55);
    --surface-track: rgba(0, 0, 0, 0.5);
    --surface-scrim: rgba(0, 0, 0, 0.28);

    /* Text */
    --text-primary: rgb(244, 246, 250);
    --text-secondary: rgba(244, 246, 250, 0.62);
    --text-shadow: rgba(0, 0, 0, 0.85);

    /* Semantic state. These are the only places colour carries meaning. */
    --state-healthy: rgb(102, 217, 112);
    --state-hurt: rgb(235, 140, 71);
    --state-critical: rgb(235, 82, 71);
    --state-stamina: rgb(115, 184, 242);
    --state-charge: rgb(250, 199, 64);
    --state-charge-ready: rgb(255, 107, 51);
    --state-threat: rgb(255, 96, 84);

    /* Spacing scale. Every margin and padding in the HUD is one of these. */
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --space-4: 32px;
    --space-5: 48px;

    /* Type ramp.

       Sized against the panel's 1080x1920 portrait reference with match-width scaling, so a
       USS pixel here is a device pixel on a 1080-wide phone. The previous ramp topped out at
       34px for everything but the result banner, which on a phone is roughly 3% of the screen
       width - legible on a monitor at a landscape aspect and not on the thing this ships to. */
    --text-xs: 24px;
    --text-sm: 28px;
    --text-md: 32px;
    --text-lg: 46px;
    --text-xl: 68px;
    --text-display: 150px;

    /* Families. Three voices, and the split is functional rather than decorative:
       Anton is the fight-poster display face and is unreadable below ~30px; Barlow
       Condensed carries everything else and is condensed because the build ships
       portrait, where a normal-width face overruns the health rows and roster tiles;
       Space Mono exists only for the diagnostics overlay, whose figures have to be
       tabular or the columns shift on every refresh. */
    --font-body: url("../../Art/Fonts/BarlowCondensed-Medium.asset");
    --font-emphasis: url("../../Art/Fonts/BarlowCondensed-SemiBold.asset");
    --font-bold: url("../../Art/Fonts/BarlowCondensed-Bold.asset");
    --font-display: url("../../Art/Fonts/Anton-Regular.asset");
    --font-mono: url("../../Art/Fonts/SpaceMono-Regular.asset");

    /* Motion. Three durations, so nothing in the HUD invents its own timing.
       Fast is for input acknowledgement, where anything slower reads as lag; base is
       for state a player is watching change; slow is for whole panels arriving. */
    --motion-fast: 80ms;
    --motion-base: 160ms;
    --motion-slow: 280ms;

    --radius: 8px;

    /* Layout bands.

       Every HUD panel is its own UIDocument, so they cannot be flex siblings of one another -
       there is no shared parent to lay them out in. They are absolutely positioned against
       their own root instead, which means nothing stops two of them claiming the same
       rectangle, and on the 1080-wide portrait reference several of them did: the diagnostics
       sheet overlapped the match panel by about 94px and the player's own panel overlapped the
       standings by about 74. It never showed in the shipped build only because _humanBoxerId
       is -1 there, so the player panel is never built at all.

       The fix is to declare the grid once, here, and have every panel opt into a slot rather
       than pick its own corner. Two columns of --col with --band-gap between them is 100%
       exactly, so no pair of panels sharing a band can ever overlap however long their content
       gets; --band-top-max then caps how far down the top band may grow, which is what keeps
       the middle of the screen - the ring - clear.

       Percentages rather than pixels throughout, so the same grid holds on a tablet and in
       landscape. The edge inset is deliberately small because SafeAreaView has already padded
       each document's root by the notch plus its own 12px, and these stack on top of that. */
    --band-edge: 16px;
    --band-gap: 8%;
    --col: 46%;
    --band-top-max: 31%;

    /* The chrome bars own the first and last rows outright, so every panel that used to anchor
       to --band-edge at the top now anchors to --band-top instead. Reserved as a token rather
       than measured per panel for the reason the rest of this grid exists: the bar is one
       element and the panels that must clear it are four, and four hand-tuned offsets is how
       the overlaps this grid was written to fix got there in the first place.

       --band-top-max came down from 36% to pay for it. The top panels start 96px lower now, and
       a max-height that did not move would have pushed their bottom edge from 707px to 787px on
       the 1920 reference - straight through the standings panel at --band-second-row. */
    --chrome-bar: 96px;
    --band-top: 112px;

    /* Where the stacked right-hand column's second panel starts. Just below --band-top-max,
       so the standings sit under the telemetry board rather than beside the match panel. */
    --band-second-row: 38%;

    /* The bottom stack, measured from the bottom edge upward. Ordered so that reading down
       the list walks up the screen: the card button sits on the floor, the player's panel
       above it, the commentary caption above that. Each gap is wide enough for the panel
       below it at its tallest. */
    --band-bottom-card: 112px;
    --band-bottom-player: 14%;
    --band-bottom-commentary: 30%;

    /* The clear middle of the screen, between the second row of panels and the bottom stack.
       The centre stage used to span the whole height and centre its content at 50%, which put
       the result banner - the largest text the game ever shows - straight through the standings
       panel starting at --band-second-row. Both are visible at once on every results screen, so
       that was not an edge case; it was the results screen. Bounding the stage by the same
       tokens the panels use makes the clearance structural rather than measured. */
    --band-centre-top: 52%;
    --band-centre-bottom: 32%;

    /* Touch controls. Sized generously: a thumb is far less precise than a cursor. */
    --touch-surface: rgba(244, 246, 250, 0.14);
    --touch-surface-strong: rgba(244, 246, 250, 0.26);
    --touch-punch: rgba(235, 140, 71, 0.30);
    --touch-punch-down: rgba(235, 140, 71, 0.62);
    --touch-charge: rgba(250, 199, 64, 0.30);
    --touch-charge-down: rgba(255, 107, 51, 0.70);
    --touch-button-size: 220px;

    /* Roster card. The tile is sized so a face reads at a glance rather than as a thumbnail. */
    --tile-width: 300px;
    --portrait-size: 216px;
    --tile-idle: rgba(244, 246, 250, 0.06);
    --tile-in: rgba(102, 217, 112, 0.16);
    --tile-in-border: rgb(102, 217, 112);
}

/* ----------------------------------------------------------------- primitives */
.text {
    color: var(--text-primary);
    -unity-font-definition: var(--font-body);
    -unity-font-style: normal;
    font-size: var(--text-sm);
    /* A shadow on every label, because the HUD sits over a bright green canvas and white
       text on it is otherwise genuinely hard to read. */
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.text--muted { color: var(--text-secondary); }
.text--xs { font-size: var(--text-xs); }
.text--sm { font-size: var(--text-sm); }
.text--md { font-size: var(--text-md); }
.text--lg { font-size: var(--text-lg); }
.text--xl { font-size: var(--text-xl); }
.text--display { font-size: var(--text-display); }

/* Weight is a different font file, not a synthesised smear. Asking TextCore to fake bold
   from the medium weight thickens the stems unevenly and blurs the SDF edge, which is
   exactly where a condensed face falls apart. */
.text--bold {
    -unity-font-definition: var(--font-bold);
    -unity-font-style: normal;
}

.text--emphasis {
    -unity-font-definition: var(--font-emphasis);
    -unity-font-style: normal;
}

/* Declared last on purpose: an element carrying both `text--display` and `text--bold`
   must land on Anton, and USS resolves a specificity tie by document order. */
.text--xl,
.text--display {
    -unity-font-definition: var(--font-display);
    -unity-font-style: normal;
}

.panel {
    background-color: var(--surface-panel);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.stack > * { margin-bottom: var(--space-1); }

.row {
    flex-direction: row;
    align-items: center;
}

/* ----------------------------------------------------------------- bars */
.bar {
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    overflow: hidden;
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--state-healthy);
}

.bar__fill--healthy { background-color: var(--state-healthy); }
.bar__fill--hurt { background-color: var(--state-hurt); }
.bar__fill--critical { background-color: var(--state-critical); }
.bar__fill--stamina { background-color: var(--state-stamina); }
.bar__fill--stamina-low { background-color: var(--state-critical); }
.bar__fill--charge { background-color: var(--state-charge); }
.bar__fill--charge-ready { background-color: var(--state-charge-ready); }

/* Only the health fills animate, and the distinction is not cosmetic. Health moves in
   discrete jumps when a punch lands, so easing the width turns a jarring snap into a
   readable drain. Stamina and the haymaker charge are recomputed every tick, and a
   transition on a value that already changes each frame just renders it permanently
   behind the model it is supposed to be reporting. */
.player-hud__bar--health > .bar__fill,
.match-hud__bar > .bar__fill {
    transition-property: width, background-color;
    transition-duration: var(--motion-base), var(--motion-slow);
    transition-timing-function: ease-out, linear;
}

.bar__label {
    width: 62px;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-body);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

/* ----------------------------------------------------------------- roster card */
/* Full-screen because picking a fight card is a modal decision, and because the tiles
   need the room to show a face large enough to recognise. */
.roster {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 11, 0.88);
}

.roster__title {
    letter-spacing: 4px;
    margin-bottom: var(--space-4);
}

/* Wide enough for three tiles per row on the 1080 portrait reference: a tile is --tile-width
   plus two --space-2 margins, so three come to 996px and a fourth cannot fit.
   At 700px only two fit, which turned eight contestants into four rows roughly 1530px tall -
   and with the title and footer on top of that, the card ran off the bottom of a phone. It
   was survivable at exactly eight and would have overflowed silently at nine. */
.roster__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 1000px;
}

.roster__footer {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    letter-spacing: 2px;
}

.roster-tile {
    width: var(--tile-width);
    margin: var(--space-2);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    align-items: center;
    background-color: var(--tile-idle);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    /* Declared at full width on every tile so that selecting one changes only the colour.
       A border that appears on selection would shift the whole grid by two pixels. */
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

/* An unselected fighter is dimmed rather than hidden: the card still has to show who is
   available, not only who was picked. */
.roster-tile { opacity: 0.45; }

.roster-tile {
    transition-property: opacity, background-color, border-color, scale;
    transition-duration: var(--motion-base);
    transition-timing-function: ease-out;
}

/* The card is the one screen with a pointer on it, so it is the one place a hover state
   earns its keep - it tells you which tile the click will land on before you commit. */
.roster-tile:hover { scale: 1.04; }

.roster-tile--in {
    opacity: 1;
    background-color: var(--tile-in);
    border-color: var(--tile-in-border);
}

.roster-tile__portrait {
    width: var(--portrait-size);
    height: var(--portrait-size);
    margin-bottom: var(--space-2);
    background-color: var(--surface-track);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.roster-tile__name { letter-spacing: 2px; }

.roster-tile__tagline {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: var(--space-1);
    min-height: 28px;
}

.roster-tile__standing {
    margin-top: var(--space-1);
    color: var(--state-charge);
    letter-spacing: 1px;
}

/* The way into the fight card on a phone. Anchored bottom-centre, thumb-sized, and shown
   only between matches - during a fight there is nothing it could usefully do. */
.card-button {
    position: absolute;
    bottom: var(--band-bottom-card);
    left: 50%;
    translate: -50% 0;
    min-width: 380px;
    height: 108px;
    color: var(--text-primary);
    background-color: var(--surface-panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--state-charge);
    border-right-color: var(--state-charge);
    border-top-color: var(--state-charge);
    border-bottom-color: var(--state-charge);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    letter-spacing: 3px;
    transition-property: scale, background-color;
    transition-duration: var(--motion-fast);
}

.card-button:hover { background-color: var(--tile-in); }
.card-button:active { scale: 0.96; }

/* ----------------------------------------------------------------- title menu */
/* Full-screen and modal, like the fight card. The scrim is what lets the display face sit on
   a controlled ground instead of over a bright green canvas, and it makes the two buttons the
   only live things on screen at a moment when the ring behind them is racked and still. */
.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 11, 0.82);
}

.menu {
    align-items: center;
    max-width: 900px;
}

/* The one place --text-display is used. Anton at 150px is roughly 14% of a 1080-wide phone,
   which is the size a fight poster's name wants to be; the ramp tops out here precisely so
   this element has somewhere to go. */
.menu__title {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    white-space: normal;
}

.menu__tagline {
    letter-spacing: 4px;
    margin-bottom: var(--space-5);
    -unity-text-align: middle-center;
}

/* Sized off the touch-button token rather than the type ramp: these are the two elements in
   the game a thumb has to find, and a button sized to its label is a button sized for a
   mouse. Full width of the panel so neither can be missed. */
.menu__button {
    width: 100%;
    min-height: 132px;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
    background-color: var(--surface-panel);
    letter-spacing: 4px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(244, 246, 250, 0.22);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: scale, background-color, border-color;
    transition-duration: var(--motion-fast);
    transition-timing-function: ease-out;
}

/* One primary action, marked by colour rather than by size. Two buttons of equal weight make
   a player read both before choosing; the fight is what they came for. */
.menu__button--primary {
    border-color: var(--state-charge);
    background-color: rgba(250, 199, 64, 0.14);
}

.menu__button:hover { background-color: var(--tile-in); }
.menu__button:active { scale: 0.97; }

.menu__hint {
    margin-top: var(--space-2);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ----------------------------------------------------------------- standings */
/* Right column, second row - directly under the telemetry board rather than bottom-right.
   It sat at bottom-right against a 470px minimum while the player's own panel sat at
   bottom-left against a 620px one, which is 1090px of panel across a 1080px screen: the two
   drew through each other on any phone with a human in the seat. Moving it up into the
   column it already shares a width with is what removes the conflict rather than papering
   over it, and it puts the league table beside the fight it is rating. */
.standings {
    position: absolute;
    right: var(--band-edge);
    top: var(--band-second-row);
    width: var(--col);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.standings__rows {
    flex-direction: column;
}

.standings__title {
    color: var(--text-secondary);
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
}

.standings__row {
    letter-spacing: 1px;
    margin-bottom: var(--space-1);
    transition-property: color;
    transition-duration: var(--motion-slow);
}

.standings__row--gain { color: var(--state-healthy); }
.standings__row--loss { color: var(--state-hurt); }

/* Faded rather than display:none, to match how the stats board hides. A panel that is only
   transparent keeps its layout resolved, which is what stops SafeAreaView's retry pass from
   seeing an unresolved panel and waiting on it for ever. */
.standings--hidden { opacity: 0; }

/* ----------------------------------------------------------------- match HUD */
/* Top band, left column. Capped in height as well as width: ten health rows is the tallest
   this panel ever gets, and without the cap a larger roster would grow it down over the ring
   with nothing to stop it. */
/* It carries the panel surface now, and it is the only one that ever went without. Every
   other panel in the HUD sits on --surface-panel; this one was bare labels and bars drawn
   straight onto the ring, relying on the text shadow alone. That was survivable while the
   spectator camera sat at its widest, and stopped being survivable once the camera started
   framing exchanges tightly - fighters pass directly behind the health column and read
   through it, which is the one place in the HUD where ten similar rows have to be told
   apart at a glance. */
.match-hud {
    position: absolute;
    top: var(--band-top);
    left: var(--band-edge);
    width: var(--col);
    max-height: var(--band-top-max);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

/* Faded on the title screen, where there is no fight for the count to describe. Opacity
   rather than display, for the reason .standings--hidden gives. */
.match-hud--hidden { opacity: 0; }

.match-hud__roster { margin-top: var(--space-2); }

.match-hud__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-1);
}

/* A share of the row rather than 190 fixed pixels. The panel is now a percentage of the
   screen, so a fixed name column plus a fixed bar could add up to more than the panel is
   wide - which overflows rather than shrinking, because a Label does not shrink below its
   text by default. flex-shrink with a zero basis is what lets the two divide whatever
   width the band actually gave them. */
.match-hud__name {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 38%;
    width: 38%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-body);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.match-hud__bar {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    height: 20px;
}

/* The result banner and the countdown live dead centre and must never take a click. */
.centre-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--band-centre-top);
    bottom: var(--band-centre-bottom);
    align-items: center;
    justify-content: center;
}

.centre-stage__caption {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.centre-stage__prompt {
    margin-top: var(--space-3);
    /* Full-strength text, not the muted token: this sits over a bright canvas rather than a
       panel, and the secondary grey was close to illegible against it. */
    color: var(--text-primary);
    letter-spacing: 2px;
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.result-banner {
    margin-top: var(--space-4);
    letter-spacing: 2px;
}

/* ----------------------------------------------------------------- player HUD */
/* Bottom band, full width. It was bottom-left against a 620px minimum, which on a 1080-wide
   phone left 460px for the standings panel that wanted 470 - so the two overlapped whenever a
   human was seated. Spanning the whole band instead means it no longer has a neighbour to
   collide with, and the bars get more room than they had. */
.player-hud {
    position: absolute;
    left: var(--band-edge);
    right: var(--band-edge);
    bottom: var(--band-bottom-player);
}

.player-hud {
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.player-hud--down { opacity: 0.4; }

.player-hud__title {
    margin-bottom: var(--space-2);
    letter-spacing: 2px;
}

.player-hud__bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

/* Flexible for the same reason the match panel's bars are: the panel is now a share of the
   screen rather than a fixed 620px, so a fixed 420px bar beside a 62px caption would overflow
   a narrow one instead of shrinking to fit. */
.player-hud__bar {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
}

.player-hud__bar--health { height: 32px; }
.player-hud__bar--minor { height: 20px; }

.player-hud__counter {
    margin-top: var(--space-2);
    color: var(--state-charge-ready);
    letter-spacing: 1px;
}

.player-hud__threat {
    margin-top: var(--space-1);
    color: var(--state-threat);
    letter-spacing: 1px;
}

/* Full-screen damage wash. Painted by the player HUD, alpha driven from C#.
   Deliberately carries no transition: the view already eases the alpha itself every
   frame, and a USS transition on top would chase a target that has already moved. */
.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(204, 13, 13, 0);
}

/* ----------------------------------------------------------------- diagnostics */
/* A full-width sheet across the top rather than a corner box. At a 620px minimum anchored
   top-right it overlapped the match panel by about 94px on the 1080 portrait reference, and
   its rows are wide runs of tabular figures that a corner box wrapped anyway. Spanning the
   band gives the columns the width they were always written for.

   It is fully opaque, unlike every other panel: this one deliberately covers what is behind
   it. A developer reading frame times is not also watching the fight, and these are dense rows
   of tabular figures that have to stay legible. At 0.92 the match panel's own labels still
   read through it and the two sets of text interleaved. */
.diag {
    position: absolute;
    top: var(--band-top);
    left: var(--band-edge);
    right: var(--band-edge);
    background-color: rgb(6, 7, 11);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.diag__tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

/* The title takes the slack so the tabs sit hard right, away from the readout's first
   column - a tab directly above a number reads as a header for it. */
.diag__title {
    flex-grow: 1;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.diag__tab {
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    -unity-font-style: normal;
    letter-spacing: 2px;
    color: var(--text-secondary);
    background-color: var(--surface-track);
    margin-left: var(--space-1);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    border-top-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transition-property: color, border-bottom-color;
    transition-duration: var(--motion-fast);
}

/* An underline rather than a fill: the sheet is already the darkest surface in the HUD, so a
   lit background on the selected tab would be the brightest thing on a screen whose point is
   the figures below it. */
.diag__tab--on {
    color: var(--text-primary);
    border-bottom-color: var(--state-stamina);
}

.diag__graph {
    height: 92px;
    background-color: var(--surface-scrim);
    margin-bottom: var(--space-2);
}

/* Monospace is load-bearing here, not a style choice: the overlay redraws four times a
   second and a proportional face re-lays every column as the digits change, so the numbers
   visibly crawl. Tabular figures hold the columns still. */
.diag__readout {
    color: var(--text-primary);
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    white-space: normal;
}

.diag__readout--over { color: var(--state-hurt); }

/* ----------------------------------------------------------------- touch controls */
/* The whole left half is the stick's catchment; the circle is only drawn where the thumb
   actually lands, so there is no painted target to hunt for first. */
.touch-stick-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 50%;
    height: 62%;
}

.touch-stick__base {
    position: absolute;
    background-color: var(--touch-surface);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.touch-stick__knob {
    position: absolute;
    background-color: var(--touch-surface-strong);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.touch-buttons {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    flex-direction: column;
    align-items: flex-end;
}

.touch-button {
    width: var(--touch-button-size);
    height: var(--touch-button-size);
    margin-top: var(--space-4);
    align-items: center;
    justify-content: center;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: var(--touch-surface);
}

.touch-button__label {
    color: var(--text-primary);
    -unity-font-definition: var(--font-bold);
    font-size: var(--text-lg);
    -unity-font-style: normal;
    letter-spacing: 2px;
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.touch-button--punch { background-color: var(--touch-punch); }
.touch-button--charge { background-color: var(--touch-charge); }
.touch-button--dodge { background-color: var(--touch-surface); }

/* Input feedback runs at --motion-fast. Anything slower than about a tenth of a second
   here stops reading as "the button responded" and starts reading as dropped input. */
.touch-button {
    transition-property: background-color, scale;
    transition-duration: var(--motion-fast);
    transition-timing-function: ease-out;
}

/* Pressed state is mostly a colour change rather than a transform: a thumb already covers
   the button, so the feedback has to be visible around its edge. The slight shrink only
   has to survive being seen in peripheral vision. */
.touch-button--down { scale: 0.95; }

.touch-button--punch.touch-button--down { background-color: var(--touch-punch-down); }
.touch-button--charge.touch-button--down { background-color: var(--touch-charge-down); }
.touch-button--dodge.touch-button--down { background-color: var(--touch-surface-strong); }

/* The player panel normally sits bottom-left, which is exactly where the stick lives. */
.player-hud--touch {
    bottom: auto;
    top: 42%;
}

/* ----------------------------------------------------------------- telemetry board */
/* Top band, right column - the match panel holds the left. It used to be 480 fixed pixels
   beside a match panel of about 490, which cleared a 1080-wide screen by roughly 36px and
   would have overlapped the moment either grew. Both are now --col, so the two columns plus
   --band-gap come to exactly 100% and the clearance is structural rather than measured. */
.stats {
    position: absolute;
    top: var(--band-top);
    right: var(--band-edge);
    width: var(--col);
    max-height: var(--band-top-max);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    /* The board has nothing to say until the director has picked a pair, and a panel of
       dashes is worse than no panel. The view toggles the modifier below. */
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.stats--hidden { opacity: 0; }

.stats__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-1);
}

/* Both names flex equally so the title stays dead centre however long either name is.
   Without this a long name on one side slides the title off the midpoint the momentum bar
   below is anchored to, and the two stop lining up. */
.stats__name {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 1px;
}

.stats__name--right { -unity-text-align: middle-right; }

.stats__title {
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.stats__momentum {
    height: 14px;
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    overflow: hidden;
}

.stats__momentum-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

/* No transition on either fill. Momentum is recomputed every tick, and easing a value that
   already changes each frame just renders it permanently behind the model reporting it -
   the same reason the stamina and charge bars carry none. */
.stats__momentum-fill--a {
    right: 50%;
    background-color: var(--state-healthy);
}

.stats__momentum-fill--b {
    left: 50%;
    background-color: var(--state-hurt);
}

.stats__momentum-centre {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    translate: -1px 0;
    background-color: var(--text-secondary);
}

.stats__spark {
    height: 62px;
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
}

.stats__rows { margin-top: var(--space-1); }

.stats__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

/* Tabular figures, for the same reason the F3 overlay uses them: these columns refresh
   several times a second, and a proportional face makes the digits visibly crawl sideways
   every time a 1 becomes a 4. */
.stats__value {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
}

.stats__value--right { -unity-text-align: middle-right; }

.stats__label {
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    flex-shrink: 0;
    min-width: 200px;
}

/* ----------------------------------------------------------------- commentary subtitle */
/* Top of the bottom stack, above the player's panel and the fight-card button - a
   match-ending line is on screen at the same instant as both.
   It used to be a bare `bottom: 430px`, a number measured against the panel heights of the
   day and silently wrong the moment any of them moved. It is now the same token scale as the
   two panels it has to clear, so the three move together. */
.commentary-band {
    position: absolute;
    left: var(--band-edge);
    right: var(--band-edge);
    bottom: var(--band-bottom-commentary);
    align-items: center;
}

/* Fades rather than appearing. A line that snaps on at full opacity reads as a UI error at
   the exact moment the player is looking somewhere else in the frame; a 280ms fade reads as
   a broadcast caption. It is also the reason the label is never emptied - clearing the text
   would collapse the box mid-fade. */
.commentary {
    opacity: 0;
    max-width: 900px;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    color: var(--text-primary);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.commentary--on { opacity: 1; }

/* ----------------------------------------------------------------- app chrome */
/* The persistent bar. Two rows that nothing else in the HUD is allowed into: the top one above
   --band-top, the bottom one below --band-bottom-card, both reserved by tokens so the panels
   underneath clear them structurally rather than by measurement.

   The container itself has no background. A chrome bar that painted a strip across the top and
   bottom of a 2D ring would read as letterboxing, and on the title screen - where the menu's
   own scrim is already dimming everything - as a second, mismatched frame. The individual
   labels and buttons carry --surface-panel instead, so each one is legible against the canvas
   without any of them claiming the whole row. */
.chrome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.chrome__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--chrome-bar);
    justify-content: center;
}

.chrome__bar--top { top: 0; }
.chrome__bar--bottom { bottom: 0; }

/* Every item in the bar is positioned against the bar rather than flowed in it. A row of three
   with space-between centres the middle item only when the two outer ones happen to be the
   same width, and here they never are: "PO RUMBLE" against a MENU button is about 90px of
   difference, which is enough to read as a mistake on the one element whose whole job is to
   sit in the middle. */
.chrome__title,
.chrome__fps,
.chrome__version {
    position: absolute;
    letter-spacing: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.chrome__title { left: var(--band-edge); }
.chrome__version { right: var(--band-edge); }

/* Centred by translate rather than by left/right:0 plus a centred text alignment, so the panel
   background is the width of the reading and not the width of the screen. */
.chrome__fps {
    left: 50%;
    translate: -50% 0;
    -unity-font-definition: var(--font-mono);
    -unity-text-align: middle-center;
    min-width: 180px;
}

/* Sized as a thumb target, not as a label. 96px at the 1080-wide reference is about 5.8mm on a
   modern phone - not the 9mm a primary control would want, but this is chrome rather than a
   game control, and a taller bar starts eating the ring it sits over. */
.chrome__button {
    position: absolute;
    height: var(--chrome-bar);
    min-width: 200px;
    letter-spacing: 3px;
    color: var(--text-primary);
    background-color: var(--surface-panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--touch-surface);
    border-right-color: var(--touch-surface);
    border-top-color: var(--touch-surface);
    border-bottom-color: var(--touch-surface);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: background-color, opacity;
    transition-duration: var(--motion-fast);
}

.chrome__button--left { left: var(--band-edge); }
.chrome__button--right { right: var(--band-edge); }

.chrome__button:hover { background-color: var(--touch-surface); }
.chrome__button:active { background-color: var(--touch-surface-strong); }

/* Lit while the sheet it opens is up, so the button reports state rather than only sending a
   request. Without it DEBUG is a control you press twice to find out what it did. */
.chrome__button--on {
    background-color: var(--touch-charge);
    border-left-color: var(--state-charge);
    border-right-color: var(--state-charge);
    border-top-color: var(--state-charge);
    border-bottom-color: var(--state-charge);
}

/* Disabled, not hidden - MENU is dead on the title screen because there is nothing to leave,
   and a control that disappears from a fixed bar reads as a glitch. */
.chrome__button:disabled {
    opacity: 0.32;
}
