/*
 * PoRumble HUD design system.
 *
 * Both HUDs used to build every element with inline style assignments, each carrying its own
 * copy of the palette as `static readonly Color` fields. The two panels could drift apart with
 * nothing to catch it, and there was no shared spacing rhythm at all.
 *
 * Everything below the token block is expressed in terms of the tokens, so the whole HUD can
 * be recoloured or respaced from one place. C# still sets values that are genuinely dynamic -
 * a bar's width percentage - but never a colour or a padding.
 */

/* ----------------------------------------------------------------- design tokens */
:root {
    /* Surfaces. Deliberately translucent: the ring has to stay readable underneath. */
    --surface-panel: rgba(8, 9, 14, 0.55);
    --surface-track: rgba(0, 0, 0, 0.5);
    --surface-scrim: rgba(0, 0, 0, 0.28);

    /* Text */
    --text-primary: rgb(244, 246, 250);
    --text-secondary: rgba(244, 246, 250, 0.62);
    --text-shadow: rgba(0, 0, 0, 0.85);

    /* Semantic state. These are the only places colour carries meaning. */
    --state-healthy: rgb(102, 217, 112);
    --state-hurt: rgb(235, 140, 71);
    --state-critical: rgb(235, 82, 71);
    --state-stamina: rgb(115, 184, 242);
    --state-charge: rgb(250, 199, 64);
    --state-charge-ready: rgb(255, 107, 51);
    --state-threat: rgb(255, 96, 84);

    /* Spacing scale. Every margin and padding in the HUD is one of these. */
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --space-4: 32px;
    --space-5: 48px;

    /* Type ramp.

       Sized against the panel's 1080x1920 portrait reference with match-width scaling, so a
       USS pixel here is a device pixel on a 1080-wide phone. The previous ramp topped out at
       34px for everything but the result banner, which on a phone is roughly 3% of the screen
       width - legible on a monitor at a landscape aspect and not on the thing this ships to. */
    --text-xs: 24px;
    --text-sm: 28px;
    --text-md: 32px;
    --text-lg: 46px;
    --text-xl: 68px;
    --text-display: 150px;

    /* Families. Three voices, and the split is functional rather than decorative:
       Anton is the fight-poster display face and is unreadable below ~30px; Barlow
       Condensed carries everything else and is condensed because the build ships
       portrait, where a normal-width face overruns the health rows and roster tiles;
       Space Mono exists only for the diagnostics overlay, whose figures have to be
       tabular or the columns shift on every refresh. */
    --font-body: url("../../Art/Fonts/BarlowCondensed-Medium.asset");
    --font-emphasis: url("../../Art/Fonts/BarlowCondensed-SemiBold.asset");
    --font-bold: url("../../Art/Fonts/BarlowCondensed-Bold.asset");
    --font-display: url("../../Art/Fonts/Anton-Regular.asset");
    --font-mono: url("../../Art/Fonts/SpaceMono-Regular.asset");

    /* Motion. Three durations, so nothing in the HUD invents its own timing.
       Fast is for input acknowledgement, where anything slower reads as lag; base is
       for state a player is watching change; slow is for whole panels arriving. */
    --motion-fast: 80ms;
    --motion-base: 160ms;
    --motion-slow: 280ms;

    --radius: 8px;

    /* Layout bands.

       Every HUD panel is its own UIDocument, so they cannot be flex siblings of one another -
       there is no shared parent to lay them out in. They are absolutely positioned against
       their own root instead, which means nothing stops two of them claiming the same
       rectangle, and on the 1080-wide portrait reference several of them did: the diagnostics
       sheet overlapped the match panel by about 94px and the player's own panel overlapped the
       standings by about 74. It never showed in the shipped build only because _humanBoxerId
       is -1 there, so the player panel is never built at all.

       The fix is to declare the grid once, here, and have every panel opt into a slot rather
       than pick its own corner. Two columns of --col with --band-gap between them is 100%
       exactly, so no pair of panels sharing a band can ever overlap however long their content
       gets; --band-top-max then caps how far down the top band may grow, which is what keeps
       the middle of the screen - the ring - clear.

       Percentages rather than pixels throughout, so the same grid holds on a tablet and in
       landscape. The edge inset is deliberately small because SafeAreaView has already padded
       each document's root by the notch plus its own 12px, and these stack on top of that. */
    --band-edge: 16px;
    --band-gap: 8%;
    --col: 46%;
    --band-top-max: 31%;

    /* The chrome bars own the first and last rows outright, so every panel that used to anchor
       to --band-edge at the top now anchors to --band-top instead. Reserved as a token rather
       than measured per panel for the reason the rest of this grid exists: the bar is one
       element and the panels that must clear it are four, and four hand-tuned offsets is how
       the overlaps this grid was written to fix got there in the first place.

       --band-top-max came down from 36% to pay for it when the bar was 96px.

       The bar is 64px now. At 96 it was a third of its height in empty margin around 28px
       labels, and the two rows together spent 10% of a 1920 screen on five small items. The
       buttons shrank with it, which is a real trade: 64px is about 3.9mm on a modern phone,
       under the 7-9mm a primary control wants. MENU and DEBUG are chrome rather than game
       controls, and both are wide (--chrome-button-width), which is most of what makes a
       thin target findable. */
    --chrome-bar: 64px;
    --band-top: 80px;
    --chrome-button-width: 200px;

    /* Where the stacked right-hand column's second panel starts. Just below --band-top-max,
       so the standings sit under the telemetry board rather than beside the match panel. */
    --band-second-row: 38%;

    /* Where the portrait carousel's slot starts: under its own tab row, which takes the top of
       the right-hand column at --band-top. The tab row is 56px plus an 8px gap. */
    --band-slot-top: 144px;

    /* The bottom stack, measured from the bottom edge upward: the floor is the bottom chrome
       row, and the player's own panel sits above it. The commentary caption used to hold a
       third band here, a third of the way up the screen; it lives inside the chrome row now. */
    --band-bottom-card: 80px;
    --band-bottom-player: 14%;

    /* The clear middle of the screen, between the second row of panels and the bottom stack.
       The centre stage used to span the whole height and centre its content at 50%, which put
       the result banner - the largest text the game ever shows - straight through the standings
       panel starting at --band-second-row. Both are visible at once on every results screen, so
       that was not an edge case; it was the results screen. Bounding the stage by the same
       tokens the panels use makes the clearance structural rather than measured.

       The bottom edge came down from 32% once the commentary band and the floating card button
       left the bottom stack: the results card is the whole results screen now and has the
       room those two used to hold. */
    --band-centre-top: 52%;
    --band-centre-bottom: 24%;

    /* Touch controls. Sized generously: a thumb is far less precise than a cursor. */
    --touch-surface: rgba(244, 246, 250, 0.14);
    --touch-surface-strong: rgba(244, 246, 250, 0.26);
    --touch-punch: rgba(235, 140, 71, 0.30);
    --touch-punch-down: rgba(235, 140, 71, 0.62);
    --touch-charge: rgba(250, 199, 64, 0.30);
    --touch-charge-down: rgba(255, 107, 51, 0.70);
    --touch-button-size: 220px;

    /* Title-screen tiles. Four to a row, so a ten-fighter card is three rows and the title
       screen fits between the chrome bars. The face is still large enough to recognise. */
    --tile-width: 23%;
    --portrait-size: 128px;
    --tile-idle: rgba(244, 246, 250, 0.06);
    --tile-in: rgba(102, 217, 112, 0.16);
    --tile-in-border: rgb(102, 217, 112);
}

/* Portrait tightening. SafeAreaView puts this class on every document root while the screen is
   taller than it is wide. The larger steps of the spacing scale were chosen against a landscape
   monitor, where 48px of margin is a sliver; on a 1080-wide phone the same margins were the
   difference between the title screen fitting and not. The small steps stay as they are - they
   are what keeps text off the panel edges, and shrinking them reads as cramped rather than dense.

   After :root on purpose, so that on an element matching both the later rule wins the tie. */
.portrait {
    --space-3: 16px;
    --space-4: 24px;
    --space-5: 32px;
}

/* ----------------------------------------------------------------- primitives */
.text {
    color: var(--text-primary);
    -unity-font-definition: var(--font-body);
    -unity-font-style: normal;
    font-size: var(--text-sm);
    /* A shadow on every label, because the HUD sits over a bright green canvas and white
       text on it is otherwise genuinely hard to read. */
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.text--muted { color: var(--text-secondary); }
.text--xs { font-size: var(--text-xs); }
.text--sm { font-size: var(--text-sm); }
.text--md { font-size: var(--text-md); }
.text--lg { font-size: var(--text-lg); }
.text--xl { font-size: var(--text-xl); }
.text--display { font-size: var(--text-display); }

/* Weight is a different font file, not a synthesised smear. Asking TextCore to fake bold
   from the medium weight thickens the stems unevenly and blurs the SDF edge, which is
   exactly where a condensed face falls apart. */
.text--bold {
    -unity-font-definition: var(--font-bold);
    -unity-font-style: normal;
}

.text--emphasis {
    -unity-font-definition: var(--font-emphasis);
    -unity-font-style: normal;
}

/* Declared last on purpose: an element carrying both `text--display` and `text--bold`
   must land on Anton, and USS resolves a specificity tie by document order. */
.text--xl,
.text--display {
    -unity-font-definition: var(--font-display);
    -unity-font-style: normal;
}

.panel {
    background-color: var(--surface-panel);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.stack > * { margin-bottom: var(--space-1); }

/* A badge: a short fact on its own small plate. Replaces the full-width heading rows the panels
   used to open with ("WIN PROBABILITY", "STANDINGS", "SURVIVORS  10 / 10") - a heading spends a
   row naming a panel, a badge spends a word stating what it says. */
.badge {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    margin-right: var(--space-1);
    letter-spacing: 1px;
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.badge--muted { color: var(--text-secondary); }
.badge--good { color: var(--state-healthy); }
.badge--bad { color: var(--state-hurt); }
.badge--pick { color: var(--state-charge); }
.badge--empty { display: none; }

.row {
    flex-direction: row;
    align-items: center;
}

/* ----------------------------------------------------------------- bars */
.bar {
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    overflow: hidden;
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--state-healthy);
}

.bar__fill--healthy { background-color: var(--state-healthy); }
.bar__fill--hurt { background-color: var(--state-hurt); }
.bar__fill--critical { background-color: var(--state-critical); }
.bar__fill--stamina { background-color: var(--state-stamina); }
.bar__fill--stamina-low { background-color: var(--state-critical); }
.bar__fill--charge { background-color: var(--state-charge); }
.bar__fill--charge-ready { background-color: var(--state-charge-ready); }

/* Only the health fills animate, and the distinction is not cosmetic. Health moves in
   discrete jumps when a punch lands, so easing the width turns a jarring snap into a
   readable drain. Stamina and the haymaker charge are recomputed every tick, and a
   transition on a value that already changes each frame just renders it permanently
   behind the model it is supposed to be reporting. */
.player-hud__bar--health > .bar__fill,
.match-hud__bar > .bar__fill {
    transition-property: width, background-color;
    transition-duration: var(--motion-base), var(--motion-slow);
    transition-timing-function: ease-out, linear;
}

.bar__label {
    width: 62px;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-body);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

/* ----------------------------------------------------------------- title screen */
/* Full-screen and modal. The scrim is what lets the display face sit on a controlled ground
   instead of over a bright green canvas, and it makes the controls the only live things on
   screen at a moment when the ring behind them is racked and still.

   Padded clear of both chrome rows rather than centred over the whole screen, so however tall
   the grid gets it is the space between MENU and DEBUG that it has to fit in - which is what the
   layout test measures it against. */
.menu-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding-top: var(--band-top);
    padding-bottom: var(--band-bottom-card);
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 11, 0.82);
}

.menu {
    align-items: center;
    width: 100%;
    max-width: 1000px;
}

/* The one place --text-display is used. Anton at 150px is roughly 14% of a 1080-wide phone,
   which is the size a fight poster's name wants to be; the ramp tops out here precisely so
   this element has somewhere to go. */
.menu__title {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    white-space: normal;
}

.menu__tagline {
    letter-spacing: 4px;
    margin-bottom: var(--space-4);
    -unity-text-align: middle-center;
}

/* PICK / CARD: what a tap on a tile does. Two buttons rather than a long-press, because a
   gesture nobody is told about is a feature nobody finds, and this switch replaced a whole
   screen that at least had a button. */
.menu__modes {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
}

.menu__mode {
    min-width: 180px;
    min-height: 80px;
    margin-right: var(--space-1);
    color: var(--text-secondary);
    background-color: var(--surface-panel);
    letter-spacing: 3px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(244, 246, 250, 0.22);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: background-color, border-color, color;
    transition-duration: var(--motion-fast);
}

.menu__mode--on {
    color: var(--text-primary);
    border-color: var(--state-charge);
    background-color: rgba(250, 199, 64, 0.22);
}

.menu__bank { margin-left: var(--space-1); }

.menu__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
}

.menu__hint {
    margin-top: var(--space-2);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Sized off the touch-button scale rather than the type ramp: this is the element in the game a
   thumb most has to find, and a button sized to its label is a button sized for a mouse. Full
   width of the panel so it cannot be missed. */
.menu__button {
    width: 100%;
    min-height: 120px;
    margin-top: var(--space-2);
    color: var(--text-primary);
    background-color: var(--surface-panel);
    letter-spacing: 4px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(244, 246, 250, 0.22);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: scale, background-color, border-color;
    transition-duration: var(--motion-fast);
    transition-timing-function: ease-out;
}

.menu__button--primary {
    border-color: var(--state-charge);
    background-color: rgba(250, 199, 64, 0.14);
}

.menu__button:hover { background-color: var(--tile-in); }
.menu__button:active { scale: 0.97; }

/* ----------------------------------------------------------------- contestant tiles */
.roster-tile {
    width: var(--tile-width);
    margin: 1%;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    align-items: center;
    background-color: var(--tile-idle);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    /* Declared at full width on every tile so that selecting one changes only the colour.
       A border that appears on selection would shift the whole grid by two pixels. */
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(0, 0, 0, 0);

    transition-property: opacity, background-color, border-color, scale;
    transition-duration: var(--motion-base);
    transition-timing-function: ease-out;
}

.roster-tile:hover { scale: 1.04; }
.roster-tile:active { scale: 0.96; }

/* CARD mode: everyone is shown, and who is on the card is lit. An unselected fighter is dimmed
   rather than hidden - the card has to show who is available, not only who was picked. */
.roster-tile--in {
    background-color: var(--tile-in);
    border-color: var(--tile-in-border);
}

.roster-tile--off { opacity: 0.4; }

/* PICK mode: only the card is shown, since nobody off it can be backed. */
.roster-tile--hidden { display: none; }

/* The backed fighter, in the charge colour the HUD uses for "yours" everywhere else. */
.roster-tile--pick {
    border-color: var(--state-charge);
    background-color: rgba(250, 199, 64, 0.22);
}

.roster-tile__portrait {
    width: var(--portrait-size);
    height: var(--portrait-size);
    margin-bottom: var(--space-1);
    background-color: var(--surface-track);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

/* Full width and centred rather than sized to the text with a max-width. The max-width form
   under-measured in TextCore and cut ALAN down to "AL..." inside a tile with room for it four
   times over; a definite width gives the ellipsis a real box to measure against. */
.roster-tile__name {
    width: 100%;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 1px;
}

.roster-tile__generation { margin-top: 2px; }

.roster-tile__badges {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
}

.roster-tile__price { color: var(--state-charge); }

/* The last badge in a row carries no trailing gap, or the pair sits visibly off-centre. */
.roster-tile__standing { margin-right: 0; }

/* ----------------------------------------------------------------- standings */
/* Right column, second row - directly under the telemetry board rather than bottom-right.
   It sat at bottom-right against a 470px minimum while the player's own panel sat at
   bottom-left against a 620px one, which is 1090px of panel across a 1080px screen: the two
   drew through each other on any phone with a human in the seat. Moving it up into the
   column it already shares a width with is what removes the conflict rather than papering
   over it, and it puts the league table beside the fight it is rating. */
.standings {
    position: absolute;
    right: var(--band-edge);
    top: var(--band-second-row);
    width: var(--col);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.standings__rows {
    flex-direction: column;
}


.standings__row {
    letter-spacing: 1px;
    margin-bottom: var(--space-1);
    transition-property: color;
    transition-duration: var(--motion-slow);
}

.standings__row--gain { color: var(--state-healthy); }
.standings__row--loss { color: var(--state-hurt); }

/* Faded rather than display:none, to match how the stats board hides. A panel that is only
   transparent keeps its layout resolved, which is what stops SafeAreaView's retry pass from
   seeing an unresolved panel and waiting on it for ever. */
.standings--hidden { opacity: 0; }

/* ----------------------------------------------------------------- field board */
/* The one list of the fighters: name, health and live win chance on one row. It used to be
   two panels - this health column and an odds board under it naming the same fighters again -
   and the viewer's stake line lived on the second.

   Top band, left column between bouts. Capped in height as well as width: twenty rows, one per seat, is
   the tallest this panel ever gets, and without the cap a larger roster would grow it down
   over the ring with nothing to stop it.

   It carries the panel surface because fighters pass directly behind it once the camera frames
   exchanges tightly, and twenty similar rows have to be told apart at a glance. */
.match-hud {
    position: absolute;
    top: var(--band-top);
    left: var(--band-edge);
    width: var(--col);
    max-height: var(--band-top-max);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: opacity;
    transition-duration: var(--motion-slow);
}

/* Faded on the title screen, where there is no fight for the count to describe. Opacity
   rather than display, for the reason .standings--hidden gives. */
.match-hud--hidden { opacity: 0; }

.match-hud__badges { flex-direction: row; }

/* Two columns of cells. Twenty one-line rows of name, bar and odds came to more than the
   --band-top-max cap, and the cap won: every row was squeezed until the names were cut in half
   across the middle. Each cell is half the panel instead - name and odds on one line, the
   health bar pinned under them - so a full ring is ten cells tall. */
.match-hud__roster {
    margin-top: var(--space-1);
    flex-direction: row;
    flex-wrap: wrap;
}

.match-hud__row {
    flex-direction: row;
    align-items: center;
    width: 50%;
    margin-bottom: 2px;
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    padding-bottom: 8px;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    transition-property: opacity;
    transition-duration: var(--motion-slow);
}

/* The viewer's backed fighter, in the charge colour the HUD uses for "yours". A human's own
   seat is marked in the stamina blue instead, so the two can never be confused. */
.match-hud__row--pick { border-left-color: var(--state-charge); }
.match-hud__row--pick .match-hud__name { color: var(--state-charge); }
.match-hud__row--you { border-left-color: var(--state-stamina); }
.match-hud__row--you .match-hud__name { color: var(--state-stamina); }
.match-hud__row--out { opacity: 0.4; }

/* Whatever the cell has left after the odds, rather than fixed pixels. The panel is a
   percentage of the screen, so a fixed name column could add up to more than the cell is wide -
   which overflows rather than shrinking, because a Label does not shrink below its text by
   default. */
.match-hud__name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-body);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

/* Out of the row's flow and along the bottom of the cell, so the name gets the full width of
   the line above it. The cell's bottom padding is the room it sits in. */
.match-hud__bar {
    position: absolute;
    left: var(--space-1);
    right: var(--space-1);
    bottom: 1px;
    height: 6px;
}

/* Tabular figures: the percentages tick four times a second and a proportional face makes
   the digits crawl sideways every time a 1 becomes a 4. */
.match-hud__odds {
    width: 64px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.match-hud__odds--up { color: var(--state-healthy); }
.match-hud__odds--down { color: var(--state-critical); }

.match-hud__pick {
    margin-top: var(--space-1);
    letter-spacing: 1px;
    white-space: normal;
    color: var(--text-secondary);
}

.match-hud__pick--won { color: var(--state-healthy); }
.match-hud__pick--lost { color: var(--state-hurt); }
.match-hud__pick--gone { display: none; }

/* The fight strip: the same board while the fight is live, as narrow cells ten to a line
   under the chrome bar. Everything else in the HUD clears off the ring for the fight, and this
   is what stays - health and win chance are the two things worth reading while it moves, and
   a strip across the top costs about 90px of ring a line rather than a third of the screen. */
.match-hud--compact {
    left: var(--band-edge);
    right: var(--band-edge);
    width: auto;
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-1);
    padding-right: var(--space-1);
}

.match-hud--compact .match-hud__badges,
.match-hud--compact .match-hud__pick { display: none; }

/* Ten cells to a line, wrapping. Twenty fighters in one row gave each cell 46px - three letters
   of a name - so a full ring takes a second line instead. The basis leaves room for the cell
   margins, and flex-grow still stretches a short field across the whole strip. */
.match-hud--compact .match-hud__roster {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 0;
}

.match-hud--compact .match-hud__row {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 9%;
    width: 9%;
    margin-bottom: 0;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    border-left-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-top: 2px;
}

.match-hud--compact .match-hud__row--pick { border-bottom-color: var(--state-charge); }
.match-hud--compact .match-hud__row--you { border-bottom-color: var(--state-stamina); }

.match-hud--compact .match-hud__name {
    flex-grow: 0;
    flex-basis: auto;
    width: auto;
    -unity-text-align: middle-center;
}

/* Back into the flow: in the strip the cell is a column and the bar sits between name and odds. */
.match-hud--compact .match-hud__bar {
    position: relative;
    left: 0;
    right: 0;
    bottom: 0;
    flex-grow: 0;
    flex-basis: auto;
    height: 10px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.match-hud--compact .match-hud__odds {
    width: auto;
    -unity-text-align: middle-center;
}

/* The countdown and the results card live in the middle of the screen. */
.centre-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--band-centre-top);
    bottom: var(--band-centre-bottom);
    align-items: center;
    justify-content: center;
}

.centre-stage__caption {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

/* ----------------------------------------------------------------- results card */
/* The whole results screen on one card: the winner, what it did to their rating and to the
   viewer's stake, and the two ways on. It replaced a bare banner, a "tap to continue" prompt,
   a floating fight-card button at the foot of the screen and a stake line on the odds board. */
.results {
    align-items: center;
    max-width: 960px;
    margin-left: var(--band-edge);
    margin-right: var(--band-edge);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.results--hidden { display: none; }

.results__winner {
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 2px;
}

.results__badges {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-1);
}

.results__actions {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-3);
}

.results__button {
    min-width: 300px;
    min-height: 108px;
    margin-left: var(--space-1);
    margin-right: var(--space-1);
    color: var(--text-primary);
    background-color: var(--surface-panel);
    letter-spacing: 3px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(244, 246, 250, 0.22);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: scale, background-color;
    transition-duration: var(--motion-fast);
}

.results__button--primary {
    border-color: var(--state-charge);
    background-color: rgba(250, 199, 64, 0.14);
}

.results__button:hover { background-color: var(--tile-in); }
.results__button:active { scale: 0.97; }

.results__hint {
    margin-top: var(--space-1);
    letter-spacing: 2px;
}

/* ----------------------------------------------------------------- player HUD */
/* Bottom band, left column. It spanned the full width while the standings sat bottom-right and
   the two were the only panels down there; the second-fight feed holds the bottom of the right
   column now, and a full-width panel drew straight through it whenever a human was seated. The
   standings moved up into the right column long ago, so the left column is free. */
.player-hud {
    position: absolute;
    left: var(--band-edge);
    width: var(--col);
    bottom: var(--band-bottom-player);
}

.player-hud {
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.player-hud--down { opacity: 0.4; }

.player-hud__title {
    margin-bottom: var(--space-2);
    letter-spacing: 2px;
}

.player-hud__bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

/* Flexible for the same reason the match panel's bars are: the panel is now a share of the
   screen rather than a fixed 620px, so a fixed 420px bar beside a 62px caption would overflow
   a narrow one instead of shrinking to fit. */
.player-hud__bar {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
}

.player-hud__bar--health { height: 32px; }
.player-hud__bar--minor { height: 20px; }

.player-hud__counter {
    margin-top: var(--space-2);
    color: var(--state-charge-ready);
    letter-spacing: 1px;
}

.player-hud__threat {
    margin-top: var(--space-1);
    color: var(--state-threat);
    letter-spacing: 1px;
}

/* Full-screen damage wash. Painted by the player HUD, alpha driven from C#.
   Deliberately carries no transition: the view already eases the alpha itself every
   frame, and a USS transition on top would chase a target that has already moved. */
.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(204, 13, 13, 0);
}

/* ----------------------------------------------------------------- diagnostics */
/* A full-width sheet across the top rather than a corner box. At a 620px minimum anchored
   top-right it overlapped the match panel by about 94px on the 1080 portrait reference, and
   its rows are wide runs of tabular figures that a corner box wrapped anyway. Spanning the
   band gives the columns the width they were always written for.

   It is fully opaque, unlike every other panel: this one deliberately covers what is behind
   it. A developer reading frame times is not also watching the fight, and these are dense rows
   of tabular figures that have to stay legible. At 0.92 the match panel's own labels still
   read through it and the two sets of text interleaved. */
.diag {
    position: absolute;
    top: var(--band-top);
    left: var(--band-edge);
    right: var(--band-edge);
    background-color: rgb(6, 7, 11);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.diag__tabs {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

/* The title takes the slack so the tabs sit hard right, away from the readout's first
   column - a tab directly above a number reads as a header for it. */
.diag__title {
    flex-grow: 1;
    color: var(--text-secondary);
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    -unity-font-style: normal;
    letter-spacing: 2px;
}

.diag__tab {
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    -unity-font-style: normal;
    letter-spacing: 2px;
    color: var(--text-secondary);
    background-color: var(--surface-track);
    margin-left: var(--space-1);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    border-top-width: 0;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transition-property: color, border-bottom-color;
    transition-duration: var(--motion-fast);
}

/* An underline rather than a fill: the sheet is already the darkest surface in the HUD, so a
   lit background on the selected tab would be the brightest thing on a screen whose point is
   the figures below it. */
.diag__tab--on {
    color: var(--text-primary);
    border-bottom-color: var(--state-stamina);
}

/* The verdict. Proportional rather than monospace, and a size up from the rows below it -
   it is prose, not a column, and the whole point of it is that it reads differently from the
   figures. Left-bordered so the ranked lines stay visibly one block when there are four of
   them and each wraps. */
.diag__verdict {
    -unity-font-definition: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: var(--space-2);
    padding-left: var(--space-2);
    border-left-width: 4px;
    border-left-color: var(--text-secondary);
}

/* Amber, not red. Red is the health bar's colour in this HUD and a red block at the top of
   the diagnostics sheet reads as a fighter in trouble rather than a build in trouble. */
.diag__verdict--bad { border-left-color: var(--state-hurt); }
.diag__verdict--ok { border-left-color: var(--state-stamina); color: var(--text-secondary); }

.diag__graph {
    height: 92px;
    background-color: var(--surface-scrim);
    margin-bottom: var(--space-2);
}

/* Monospace is load-bearing here, not a style choice: the overlay redraws four times a
   second and a proportional face re-lays every column as the digits change, so the numbers
   visibly crawl. Tabular figures hold the columns still. */
.diag__readout {
    color: var(--text-primary);
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
    white-space: normal;
}

.diag__readout--over { color: var(--state-hurt); }

/* Collapsed: the verdict alone, docked on the bottom chrome row rather than over the top of the
   ring. DEBUG opens the sheet like this; tapping the verdict opens the rest.

   Left column only, directly above the DEBUG button that opened it. At full width it sat across
   the second-fight feed, which holds the bottom of the right column - the layout test found
   that one before a screen did. */
.diag--collapsed {
    top: auto;
    right: auto;
    width: var(--col);
    bottom: var(--band-bottom-card);
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
}

.diag--collapsed .diag__tabs,
.diag--collapsed .diag__graph,
.diag--collapsed .diag__readout { display: none; }

.diag--collapsed .diag__verdict { margin-bottom: 0; }

/* The verdict is the sheet's expand control, so it answers a pointer like one. */
.diag__verdict:hover { background-color: var(--surface-track); }

/* ----------------------------------------------------------------- touch controls */
/* The whole left half is the stick's catchment; the circle is only drawn where the thumb
   actually lands, so there is no painted target to hunt for first. */
.touch-stick-zone {
    position: absolute;
    left: 0;
    bottom: var(--band-bottom-card);
    width: 50%;
    height: 56%;
}

.touch-stick__base {
    position: absolute;
    background-color: var(--touch-surface);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.touch-stick__knob {
    position: absolute;
    background-color: var(--touch-surface-strong);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

/* Clear of the bottom chrome row: the cluster used to sit 48px off the floor, which is inside
   the row the version label and the commentary caption now share. */
.touch-buttons {
    position: absolute;
    right: var(--space-5);
    bottom: var(--band-bottom-card);
    flex-direction: column;
    align-items: flex-end;
}

.touch-button {
    width: var(--touch-button-size);
    height: var(--touch-button-size);
    margin-top: var(--space-4);
    align-items: center;
    justify-content: center;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: var(--touch-surface);
}

.touch-button__label {
    color: var(--text-primary);
    -unity-font-definition: var(--font-bold);
    font-size: var(--text-lg);
    -unity-font-style: normal;
    letter-spacing: 2px;
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.touch-button--punch { background-color: var(--touch-punch); }
.touch-button--charge { background-color: var(--touch-charge); }
.touch-button--dodge { background-color: var(--touch-surface); }

/* Input feedback runs at --motion-fast. Anything slower than about a tenth of a second
   here stops reading as "the button responded" and starts reading as dropped input. */
.touch-button {
    transition-property: background-color, scale;
    transition-duration: var(--motion-fast);
    transition-timing-function: ease-out;
}

/* Pressed state is mostly a colour change rather than a transform: a thumb already covers
   the button, so the feedback has to be visible around its edge. The slight shrink only
   has to survive being seen in peripheral vision. */
.touch-button--down { scale: 0.95; }

.touch-button--punch.touch-button--down { background-color: var(--touch-punch-down); }
.touch-button--charge.touch-button--down { background-color: var(--touch-charge-down); }
.touch-button--dodge.touch-button--down { background-color: var(--touch-surface-strong); }

/* On a touchscreen the player's bars leave the panel altogether. Breath and the haymaker charge
   are drawn as rings around PUNCH and POWER by TouchControlsView - where the thumbs already are -
   and health is the player's own cell on the field strip, marked in blue. What stays here is
   the two callouts, which are warnings rather than meters and have to be read mid-exchange:
   centred just below the middle of the screen, clear of the stick and the button cluster. */
.player-hud--touch {
    bottom: auto;
    top: 42%;
    left: var(--band-edge);
    right: var(--band-edge);
    width: auto;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
}

.player-hud--touch .player-hud__title,
.player-hud--touch .player-hud__bar-row { display: none; }

/* ----------------------------------------------------------------- telemetry board */
/* Top band, right column - the match panel holds the left. It used to be 480 fixed pixels
   beside a match panel of about 490, which cleared a 1080-wide screen by roughly 36px and
   would have overlapped the moment either grew. Both are now --col, so the two columns plus
   --band-gap come to exactly 100% and the clearance is structural rather than measured. */
.stats {
    position: absolute;
    top: var(--band-top);
    right: var(--band-edge);
    width: var(--col);
    max-height: var(--band-top-max);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    /* The board has nothing to say until the director has picked a pair, and a panel of
       dashes is worse than no panel. The view toggles the modifier below. */
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.stats--hidden { opacity: 0; }

.stats__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-1);
}

/* Both names flex equally so the title stays dead centre however long either name is.
   Without this a long name on one side slides the title off the midpoint the momentum bar
   below is anchored to, and the two stop lining up. */
.stats__name {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 1px;
}

.stats__name--right { -unity-text-align: middle-right; }

/* Each fighter's share of the pair's win chance, beside their name. Fixed to its text so the
   two names still split the rest of the row evenly and the midpoint stays over the momentum
   bar's centre line. */
.stats__share {
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
}

.stats__momentum {
    height: 14px;
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    overflow: hidden;
}

.stats__momentum-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
}

/* No transition on either fill. Momentum is recomputed every tick, and easing a value that
   already changes each frame just renders it permanently behind the model reporting it -
   the same reason the stamina and charge bars carry none. */
.stats__momentum-fill--a {
    right: 50%;
    background-color: var(--state-healthy);
}

.stats__momentum-fill--b {
    left: 50%;
    background-color: var(--state-hurt);
}

.stats__momentum-centre {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    translate: -1px 0;
    background-color: var(--text-secondary);
}

.stats__spark {
    height: 62px;
    margin-top: var(--space-1);
    margin-bottom: var(--space-1);
}

.stats__rows { margin-top: var(--space-1); }

.stats__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

/* Tabular figures, for the same reason the F3 overlay uses them: these columns refresh
   several times a second, and a proportional face makes the digits visibly crawl sideways
   every time a 1 becomes a 4. */
.stats__value {
    flex-grow: 1;
    flex-basis: 0;
    width: 0;
    -unity-font-definition: var(--font-mono);
    font-size: var(--text-xs);
}

.stats__value--right { -unity-text-align: middle-right; }

.stats__label {
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    flex-shrink: 0;
    min-width: 200px;
}

/* ----------------------------------------------------------------- commentary subtitle */
/* Inside the bottom chrome row, between DEBUG on the left and the version on the right. The
   insets are the button's width plus the edge and one gap, so the caption can never run under
   either. It used to hold a band of its own a third of the way up the screen, over the ring -
   which is why it was cleared off for the whole fight, when most of the lines are spoken. */
.commentary-band {
    position: absolute;
    left: 232px;
    right: 232px;
    bottom: 0;
    height: var(--chrome-bar);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* Fades rather than appearing. A line that snaps on at full opacity reads as a UI error at
   the exact moment the player is looking somewhere else in the frame; a 280ms fade reads as
   a broadcast caption. It is also the reason the label is never emptied - clearing the text
   would collapse the box mid-fade. */
/* Two lines at most: the row is 64px and a line of the xs face is about 29. */
.commentary {
    opacity: 0;
    max-height: var(--chrome-bar);
    overflow: hidden;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    color: var(--text-primary);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: opacity;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.commentary--on { opacity: 1; }

/* ----------------------------------------------------------------- app chrome */
/* The persistent bar. Two rows that nothing else in the HUD is allowed into: the top one above
   --band-top, the bottom one below --band-bottom-card, both reserved by tokens so the panels
   underneath clear them structurally rather than by measurement.

   The container itself has no background. A chrome bar that painted a strip across the top and
   bottom of a 2D ring would read as letterboxing, and on the title screen - where the menu's
   own scrim is already dimming everything - as a second, mismatched frame. The individual
   labels and buttons carry --surface-panel instead, so each one is legible against the canvas
   without any of them claiming the whole row. */
.chrome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.chrome__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--chrome-bar);
    justify-content: center;
}

.chrome__bar--top { top: 0; }
.chrome__bar--bottom { bottom: 0; }

/* Every item in the bar is positioned against the bar rather than flowed in it. A row of three
   with space-between centres the middle item only when the two outer ones happen to be the
   same width, and here they never are: "PO RUMBLE" against a MENU button is about 90px of
   difference, which is enough to read as a mistake on the one element whose whole job is to
   sit in the middle. */
.chrome__title,
.chrome__status,
.chrome__version {
    position: absolute;
    letter-spacing: 2px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.chrome__title { left: var(--band-edge); }
.chrome__version { right: var(--band-edge); }

/* The bout, centred: its number on the menu, the clock and the field while the fight is live.
   Centred by translate rather than by left/right:0 plus a centred text alignment, so the panel
   background is the width of the reading and not the width of the screen. Mono for the digits,
   so the clock does not jitter as it ticks. */
.chrome__status {
    left: 50%;
    translate: -50% 0;
    -unity-font-definition: var(--font-mono);
    -unity-text-align: middle-center;
    min-width: 180px;
    transition-property: color;
    transition-duration: var(--motion-base);
}

/* The ropes are about to move, or moving. Amber, like every warning that is not a fighter's
   health, which owns red. */
.chrome__status--alert { color: var(--state-charge); }

/* Sized as a thumb target, not as a label - see --chrome-bar for what the 64px height costs.
   The width is the half of the target that did not have to shrink. */
.chrome__button {
    position: absolute;
    height: var(--chrome-bar);
    min-width: var(--chrome-button-width);
    letter-spacing: 3px;
    color: var(--text-primary);
    background-color: var(--surface-panel);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--touch-surface);
    border-right-color: var(--touch-surface);
    border-top-color: var(--touch-surface);
    border-bottom-color: var(--touch-surface);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: background-color, opacity;
    transition-duration: var(--motion-fast);
}

.chrome__button--left { left: var(--band-edge); }
.chrome__button--right { right: var(--band-edge); }

.chrome__button:hover { background-color: var(--touch-surface); }
.chrome__button:active { background-color: var(--touch-surface-strong); }

/* Lit while the sheet it opens is up, so the button reports state rather than only sending a
   request. Without it DEBUG is a control you press twice to find out what it did. */
.chrome__button--on {
    background-color: var(--touch-charge);
    border-left-color: var(--state-charge);
    border-right-color: var(--state-charge);
    border-top-color: var(--state-charge);
    border-bottom-color: var(--state-charge);
}

/* Disabled, not hidden - MENU is dead on the title screen because there is nothing to leave,
   and a control that disappears from a fixed bar reads as a glitch. */
.chrome__button:disabled {
    opacity: 0.32;
}

/* ----------------------------------------------------------------- second-fight feed */
/* Bottom-right while the fight is live, above the bottom chrome row - it used to sit on the
   floor, straight over the version label. The frame's height is set from its width in C#, since
   USS has no aspect-ratio. */
.pip {
    position: absolute;
    right: var(--band-edge);
    bottom: var(--band-bottom-card);
    width: var(--col);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: var(--surface-panel);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: var(--state-charge);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: opacity, translate;
    transition-duration: var(--motion-slow);
    transition-timing-function: ease-out;
}

.pip--hidden {
    opacity: 0;
    translate: 0 24px;
}

.pip__feed {
    width: 100%;
    height: 200px;
    background-color: var(--surface-track);
    -unity-background-scale-mode: scale-and-crop;
}

.pip__caption {
    margin-top: 6px;
    letter-spacing: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ----------------------------------------------------------------- portrait carousel */
/* In portrait, HudCarouselView moves the telemetry board and the standings into the one
   top-right slot and shows them a turn at a time, under a row of tabs naming them. Two columns
   of panels start a second row over a third of the way down a 1080x1920 screen, so on a phone
   the ring was being watched through the gaps; one slot hands the second row back to the ring
   and means nothing can ever need to scroll.

   Last in the file on purpose: these override the panels' own top/left/right at the same
   specificity, so they have to come after them. */
.carousel-tabs {
    position: absolute;
    top: var(--band-top);
    right: var(--band-edge);
    width: var(--col);
    height: 56px;
    flex-direction: row;
}

.carousel-tabs--hidden { display: none; }

.carousel-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 0;
    margin-right: 4px;
    color: var(--text-secondary);
    background-color: var(--surface-panel);
    letter-spacing: 2px;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    transition-property: color, border-bottom-color;
    transition-duration: var(--motion-fast);
}

.carousel-tab:hover { background-color: var(--surface-track); }

/* An underline, like the diagnostics tabs: the tab row sits over the ring and a lit fill on the
   current tab would be brighter than the panel it names. */
.carousel-tab--on {
    color: var(--text-primary);
    border-bottom-color: var(--state-charge);
}

/* A panel with nothing to show this phase takes no tab. */
.carousel-tab--off { display: none; }

.hud-carousel--slotted {
    top: var(--band-slot-top);
    right: var(--band-edge);
    left: auto;
    max-height: 28%;
    overflow: hidden;
}

/* Opacity, like every other panel's hidden state, so SafeAreaView keeps a resolved layout.
   Instant on the way out: .stats fades its opacity over --motion-slow and .standings does not,
   so a swap snapped the table in while the tape was still fading out, and the two translucent
   panels overprinted each other in the one slot. The incoming panel keeps its own fade. */
.hud-carousel--off {
    opacity: 0;
    transition-duration: 0s;
}

/* ================================================================= broadcast additions */
/* Declared here rather than in the band block at the top so everything the knockout feed, the
   follow tag and the tale of the tape need sits in one place. A later :root merges with the
   first one. */
:root {
    /* Under the live fight strip, which is --band-top plus its own height: two lines of cells
       with a full twenty-seat ring, 184 at the reference. */
    --band-feed-top: 320px;
    --tape-portrait-size: 140px;
    --result-portrait-size: 160px;
}

/* ----------------------------------------------------------------- thumb reach (portrait) */
/* On a phone the title screen's controls sat in the middle of the screen, a stretch away for a
   thumb, while the bottom third was dim backdrop. The panel now sits on the bottom band: FIGHT
   is the lowest thing on screen above DEBUG, and the title reads above the grid. */
.portrait .menu-screen { justify-content: flex-end; }

/* The results card's own stage. It shared the centre stage with the countdown, which pinned it
   to the middle of the screen - over the ring, with the empty band under the ring going
   unused. Landscape keeps the old middle band; portrait anchors the card to the bottom band. */
.results-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--band-centre-top);
    bottom: var(--band-centre-bottom);
    align-items: center;
    justify-content: center;
}

.portrait .results-stage {
    top: auto;
    bottom: var(--band-bottom-card);
    justify-content: flex-end;
}

/* ----------------------------------------------------------------- results card: the winner */
.results__portrait {
    width: var(--result-portrait-size);
    height: var(--result-portrait-size);
    margin-bottom: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--state-charge);
}

.results__portrait--gone { display: none; }

.results__stats {
    margin-top: 4px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.results__stats--gone { display: none; }

/* ----------------------------------------------------------------- title tiles: corners */
/* "x2" on a contestant a short card deals two corners. Amber like the price, because it is the
   other thing on the tile that changes what a bet on them means. */
.roster-tile__seats {
    color: var(--text-primary);
    background-color: rgba(250, 199, 64, 0.30);
    margin-left: 4px;
    margin-right: 0;
}

.roster-tile__seats--gone { display: none; }

/* ----------------------------------------------------------------- field board: pinned */
/* The fighter the viewer told the camera to follow. Blue, the colour the board already uses for
   "this one is yours", and a fill rather than the underline the pick and the human carry, so a
   pinned pick still shows both. */
.match-hud__row--pinned { background-color: rgba(115, 184, 242, 0.28); }

/* ----------------------------------------------------------------- knockout feed */
/* Under the fight strip, centred. Three lines, newest on top; each fades on its own timer.
   Opacity rather than display, so the feed's height never changes under the ring. */
.feed {
    position: absolute;
    left: var(--band-edge);
    right: var(--band-edge);
    top: var(--band-feed-top);
    align-items: center;
}

.feed__toast {
    margin-bottom: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    letter-spacing: 2px;
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-slow);
}

.feed__toast--on { opacity: 1; }
.feed__toast--good { color: var(--state-healthy); }
.feed__toast--bad { color: var(--state-critical); }
.feed__toast--alert { color: var(--state-charge); }

/* ----------------------------------------------------------------- follow tag */
/* Over the head of whoever the camera is on. Positioned from C# at the point above the fighter;
   the translate hangs the tag from that point, centred, so it never covers the fighter. */
.focus-tag {
    position: absolute;
    translate: -50% -100%;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: var(--space-1);
    padding-right: var(--space-1);
    letter-spacing: 2px;
    color: var(--text-primary);
    background-color: var(--surface-panel);
    border-bottom-width: 3px;
    border-bottom-color: var(--text-secondary);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-base);
}

.focus-tag--on { opacity: 1; }
.focus-tag--pinned { border-bottom-color: var(--state-stamina); }

/* ----------------------------------------------------------------- tale of the tape */
/* The bottom band during the intro and the countdown: clear of the full field board above and
   of the countdown number in the centre stage. */
.tape {
    position: absolute;
    left: var(--band-edge);
    right: var(--band-edge);
    bottom: var(--band-bottom-card);
    align-items: center;
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    transition-property: opacity;
    transition-duration: var(--motion-base);
}

.tape--hidden { opacity: 0; }

.tape__headline {
    letter-spacing: 4px;
    margin-bottom: var(--space-1);
}

.tape__row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
}

.tape__side {
    width: 42%;
    align-items: center;
}

.tape__portrait {
    width: var(--tape-portrait-size);
    height: var(--tape-portrait-size);
    margin-bottom: var(--space-1);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.tape__name {
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
    letter-spacing: 2px;
}

.tape__line {
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.tape__price { color: var(--state-charge); }

.tape__vs {
    width: 16%;
    -unity-text-align: middle-center;
    color: var(--state-charge);
}

/* ----------------------------------------------------------------- carousel: time left */
/* How long until the slot turns over, as a bar under the tabs, so the swap is not a surprise
   halfway through reading a board. Drains; a tap or a swipe refills it for the long hold. */
.carousel-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4px;
    width: 0;
    background-color: var(--state-charge);
    opacity: 0.7;
}

/* ----------------------------------------------------------------- DEBUG: findings, safe area */
/* The amber "this build has something wrong with it" signal, on the button that leads to the
   reason. It rode on the frame counter while that sat top-centre. */
.chrome__button--alert {
    color: var(--state-hurt);
    border-left-color: var(--state-hurt);
    border-right-color: var(--state-hurt);
    border-top-color: var(--state-hurt);
    border-bottom-color: var(--state-hurt);
}

/* The safe area, outlined while the sheet is open: this document's root is inset by
   SafeAreaView like every other, so its edges are the safe rectangle. A notch regression shows
   up on a device as the outline cutting into the status bar. */
.diag__safe {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(115, 184, 242, 0.8);
}

.diag__safe--hidden { display: none; }
