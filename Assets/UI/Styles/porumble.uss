/*
 * PoRumble HUD design system.
 *
 * Both HUDs used to build every element with inline style assignments, each carrying its own
 * copy of the palette as `static readonly Color` fields. The two panels could drift apart with
 * nothing to catch it, and there was no shared spacing rhythm at all.
 *
 * Everything below the token block is expressed in terms of the tokens, so the whole HUD can
 * be recoloured or respaced from one place. C# still sets values that are genuinely dynamic -
 * a bar's width percentage - but never a colour or a padding.
 */

/* ----------------------------------------------------------------- design tokens */
:root {
    /* Surfaces. Deliberately translucent: the ring has to stay readable underneath. */
    --surface-panel: rgba(8, 9, 14, 0.55);
    --surface-track: rgba(0, 0, 0, 0.5);
    --surface-scrim: rgba(0, 0, 0, 0.28);

    /* Text */
    --text-primary: rgb(244, 246, 250);
    --text-secondary: rgba(244, 246, 250, 0.62);
    --text-shadow: rgba(0, 0, 0, 0.85);

    /* Semantic state. These are the only places colour carries meaning. */
    --state-healthy: rgb(102, 217, 112);
    --state-hurt: rgb(235, 140, 71);
    --state-critical: rgb(235, 82, 71);
    --state-stamina: rgb(115, 184, 242);
    --state-charge: rgb(250, 199, 64);
    --state-charge-ready: rgb(255, 107, 51);
    --state-threat: rgb(255, 96, 84);

    /* Spacing scale. Every margin and padding in the HUD is one of these. */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;

    /* Type ramp */
    --text-xs: 11px;
    --text-sm: 13px;
    --text-md: 15px;
    --text-lg: 22px;
    --text-xl: 34px;
    --text-display: 90px;

    --radius: 3px;

    /* Touch controls. Sized generously: a thumb is far less precise than a cursor. */
    --touch-surface: rgba(244, 246, 250, 0.14);
    --touch-surface-strong: rgba(244, 246, 250, 0.26);
    --touch-punch: rgba(235, 140, 71, 0.30);
    --touch-punch-down: rgba(235, 140, 71, 0.62);
    --touch-charge: rgba(250, 199, 64, 0.30);
    --touch-charge-down: rgba(255, 107, 51, 0.70);
    --touch-button-size: 168px;

    /* Roster card. The tile is sized so a face reads at a glance rather than as a thumbnail. */
    --tile-width: 150px;
    --portrait-size: 108px;
    --tile-idle: rgba(244, 246, 250, 0.06);
    --tile-in: rgba(102, 217, 112, 0.16);
    --tile-in-border: rgb(102, 217, 112);
}

/* ----------------------------------------------------------------- primitives */
.text {
    color: var(--text-primary);
    -unity-font-style: normal;
    font-size: var(--text-sm);
    /* A shadow on every label, because the HUD sits over a bright green canvas and white
       text on it is otherwise genuinely hard to read. */
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.text--muted { color: var(--text-secondary); }
.text--xs { font-size: var(--text-xs); }
.text--sm { font-size: var(--text-sm); }
.text--md { font-size: var(--text-md); }
.text--lg { font-size: var(--text-lg); }
.text--xl { font-size: var(--text-xl); }
.text--display { font-size: var(--text-display); }
.text--bold { -unity-font-style: bold; }

.panel {
    background-color: var(--surface-panel);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.stack > * { margin-bottom: var(--space-1); }

.row {
    flex-direction: row;
    align-items: center;
}

/* ----------------------------------------------------------------- bars */
.bar {
    background-color: var(--surface-track);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
    overflow: hidden;
}

.bar__fill {
    height: 100%;
    width: 100%;
    background-color: var(--state-healthy);
}

.bar__fill--healthy { background-color: var(--state-healthy); }
.bar__fill--hurt { background-color: var(--state-hurt); }
.bar__fill--critical { background-color: var(--state-critical); }
.bar__fill--stamina { background-color: var(--state-stamina); }
.bar__fill--stamina-low { background-color: var(--state-critical); }
.bar__fill--charge { background-color: var(--state-charge); }
.bar__fill--charge-ready { background-color: var(--state-charge-ready); }

.bar__label {
    width: 62px;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

/* ----------------------------------------------------------------- roster card */
/* Full-screen because picking a fight card is a modal decision, and because the tiles
   need the room to show a face large enough to recognise. */
.roster {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 7, 11, 0.88);
}

.roster__title {
    letter-spacing: 4px;
    margin-bottom: var(--space-4);
}

.roster__grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 700px;
}

.roster__footer {
    margin-top: var(--space-4);
    color: var(--text-secondary);
    letter-spacing: 2px;
}

.roster-tile {
    width: var(--tile-width);
    margin: var(--space-2);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    padding-left: var(--space-2);
    padding-right: var(--space-2);
    align-items: center;
    background-color: var(--tile-idle);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    /* Declared at full width on every tile so that selecting one changes only the colour.
       A border that appears on selection would shift the whole grid by two pixels. */
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

/* An unselected fighter is dimmed rather than hidden: the card still has to show who is
   available, not only who was picked. */
.roster-tile { opacity: 0.45; }

.roster-tile--in {
    opacity: 1;
    background-color: var(--tile-in);
    border-color: var(--tile-in-border);
}

.roster-tile__portrait {
    width: var(--portrait-size);
    height: var(--portrait-size);
    margin-bottom: var(--space-2);
    background-color: var(--surface-track);
    -unity-background-scale-mode: scale-and-crop;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.roster-tile__name { letter-spacing: 2px; }

.roster-tile__tagline {
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: var(--space-1);
    min-height: 28px;
}

.roster-tile__standing {
    margin-top: var(--space-1);
    color: var(--state-charge);
    letter-spacing: 1px;
}

/* ----------------------------------------------------------------- standings */
.standings {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    min-width: 240px;
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.standings__title {
    color: var(--text-secondary);
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
}

.standings__row {
    letter-spacing: 1px;
    margin-bottom: var(--space-1);
}

.standings__row--gain { color: var(--state-healthy); }
.standings__row--loss { color: var(--state-hurt); }

/* ----------------------------------------------------------------- match HUD */
.match-hud {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
}

.match-hud__roster { margin-top: var(--space-2); }

.match-hud__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-1);
}

.match-hud__name {
    /* Wide enough for a contestant's name. It used to hold "#00" and nothing else, and a
       card of named fighters overflowed it silently. */
    width: 84px;
    color: var(--text-secondary);
    font-size: var(--text-xs);
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.match-hud__bar {
    width: 132px;
    height: 9px;
}

/* The result banner and the countdown live dead centre and must never take a click. */
.centre-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.centre-stage__caption {
    -unity-text-align: middle-center;
    letter-spacing: 4px;
}

.centre-stage__prompt {
    margin-top: var(--space-3);
    /* Full-strength text, not the muted token: this sits over a bright canvas rather than a
       panel, and the secondary grey was close to illegible against it. */
    color: var(--text-primary);
    letter-spacing: 2px;
    padding-top: var(--space-1);
    padding-bottom: var(--space-1);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    background-color: var(--surface-panel);
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
}

.result-banner {
    margin-top: var(--space-4);
    letter-spacing: 2px;
}

/* ----------------------------------------------------------------- player HUD */
.player-hud {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    min-width: 300px;
}

.player-hud--down { opacity: 0.4; }

.player-hud__title {
    margin-bottom: var(--space-2);
    letter-spacing: 2px;
}

.player-hud__bar-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

.player-hud__bar { width: 196px; }
.player-hud__bar--health { height: 15px; }
.player-hud__bar--minor { height: 9px; }

.player-hud__counter {
    margin-top: var(--space-2);
    color: var(--state-charge-ready);
    letter-spacing: 1px;
}

.player-hud__threat {
    margin-top: var(--space-1);
    color: var(--state-threat);
    letter-spacing: 1px;
}

/* Full-screen damage wash. Painted by the player HUD, alpha driven from C#. */
.vignette {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(204, 13, 13, 0);
}

/* ----------------------------------------------------------------- diagnostics */
.diag {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background-color: var(--surface-panel);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    padding-left: var(--space-3);
    padding-right: var(--space-3);
    min-width: 340px;
}

.diag__title {
    color: var(--text-secondary);
    font-size: var(--text-xs);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
}

.diag__graph {
    height: 46px;
    background-color: var(--surface-scrim);
    margin-bottom: var(--space-2);
}

.diag__readout {
    color: var(--text-primary);
    font-size: var(--text-xs);
    white-space: normal;
}

.diag__readout--over { color: var(--state-hurt); }

/* ----------------------------------------------------------------- touch controls */
/* The whole left half is the stick's catchment; the circle is only drawn where the thumb
   actually lands, so there is no painted target to hunt for first. */
.touch-stick-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 50%;
    height: 62%;
}

.touch-stick__base {
    position: absolute;
    background-color: var(--touch-surface);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.touch-stick__knob {
    position: absolute;
    background-color: var(--touch-surface-strong);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.touch-buttons {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    flex-direction: column;
    align-items: flex-end;
}

.touch-button {
    width: var(--touch-button-size);
    height: var(--touch-button-size);
    margin-top: var(--space-4);
    align-items: center;
    justify-content: center;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: var(--touch-surface);
}

.touch-button__label {
    color: var(--text-primary);
    font-size: var(--text-lg);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 1px 1px 2px var(--text-shadow);
}

.touch-button--punch { background-color: var(--touch-punch); }
.touch-button--charge { background-color: var(--touch-charge); }
.touch-button--dodge { background-color: var(--touch-surface); }

/* Pressed state is a colour change rather than a transform: a thumb already covers the
   button, so the feedback has to be visible around its edge. */
.touch-button--punch.touch-button--down { background-color: var(--touch-punch-down); }
.touch-button--charge.touch-button--down { background-color: var(--touch-charge-down); }
.touch-button--dodge.touch-button--down { background-color: var(--touch-surface-strong); }

/* The player panel normally sits bottom-left, which is exactly where the stick lives. */
.player-hud--touch {
    bottom: auto;
    top: 42%;
}
